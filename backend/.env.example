# ===== LLM 配置（OpenAI 兼容协议）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ===== 服务配置 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 数据路径 =====
DATA_DIR=../data
PAPERS_DIR=../data/papers
CHROMA_DIR=../data/chroma
DB_PATH=../data/litread.db

# ===== Embedding 模型 =====
# 中文推荐 BAAI/bge-small-zh-v1.5；英文可用 all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu   # 有 GPU 可填 cuda

# ===== RAG 配置 =====
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6

# ===== 图谱配置 =====
GRAPH_SIMILARITY_THRESHOLD=0.55  # 相似度高于此值才连边

# 摘要时传给 LLM 的最大字符数
SUMMARY_MAX_CHARS=15000
